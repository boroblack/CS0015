void getStudentGrade() {
    char name[NAME_LEN], id[ID_LEN];
    int index;
    float mcg, fcg;
    
    printf("\nPlease input name and ID.\n");
    printf("Student Name (SN, FM MI): ");
    fgets(name, NAME_LEN, stdin);
    name[strcspn(name, "\n")] = 0;
    
    printf("Student ID Number: ");
    fgets(id, ID_LEN, stdin);
    id[strcspn(id, "\n")] = 0;
    
    index = findStudentIndex(name, id);
    
    if(index == -1 || students[index].hasLecture == 0 || students[index].hasLab == 0) {
        printf("Student data not found or incomplete!\n");
        return;
    }
    
    printf("\nStudent Name: %s\n", students[index].name);
    printf("Student ID Number: %s\n", students[index].id);
    printf("Course: CCS0007/CCS0007L\n");
    printf("Section: %s\n", students[index].section);
    
    // Lecture Grade Display
    printf("\nLecture Grade\n");
    printf("SA1 SA2 SA3 SA4 MP FP ME FE MLEC FLEC\n");
    printf("==== ==== ==== ==== ==== ==== ==== ==== ===== =====\n");
    printf("%-4d %-4d %-4d %-4d %-4d %-4d %-4d %-4d %-6.2f %-6.2f\n",
           students[index].lecture.sa1, students[index].lecture.sa2,
           students[index].lecture.sa3, students[index].lecture.sa4,
           students[index].lecture.mp, students[index].lecture.fp,
           students[index].lecture.me, students[index].lecture.fe,
           students[index].lecture.mlec, students[index].lecture.flec);
    
    // Laboratory Grade Display
    printf("\nLaboratory Grade\n");
    printf("TA1 TA2 TA3 TA4 TA5 TA6 TA7 TA8 ME FE MLAB FLAB\n");
    printf("==== ==== ==== ==== ==== ==== ==== ==== ==== ==== ===== =====\n");
    printf("%-4d %-4d %-4d %-4d %-4d %-4d %-4d %-4d %-4d %-4d %-6.2f %-6.2f\n",
           students[index].lab.ta1, students[index].lab.ta2,
           students[index].lab.ta3, students[index].lab.ta4,
           students[index].lab.ta5, students[index].lab.ta6,
           students[index].lab.ta7, students[index].lab.ta8,
           students[index].lab.me, students[index].lab.fe,
           students[index].lab.mlab, students[index].lab.flab);
    
    // Course Grade Computation
    mcg = computeCourseGrade(students[index].lecture.mlec, students[index].lab.mlab, 1);
    fcg = computeCourseGrade(students[index].lecture.flec, students[index].lab.flab, 0);
    float avgGrade = (mcg + fcg) / 2;
    
    printf("\nCourse Grade\n");
    printf("MCG    FCG    EQV    REMARKS\n");
    printf("===== ===== ===== =========\n");
    printf("%-6.2f %-6.2f %-6s %s\n", mcg, fcg, getEquivalentGrade(avgGrade), getRemarks(avgGrade));
}

void displayAllStudents() {
    printf("\nTotal Number of Student Listed: %d\n", studentCount);
    printf("Course: CCS0007/CCS0007L\n");
    if(studentCount > 0) {
        printf("Section: %s\n", students[0].section);
    }
    printf("No. Student Name (SN, FN MI) Student ID No.\n");
    printf("=== =========================== ==============\n");
    for(int i = 0; i < studentCount; i++) {
        printf("%-3d %-27s %s\n", i+1, students[i].name, students[i].id);
    }
}

