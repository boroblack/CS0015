#include <iostream>
using namespace std;

// Function to find frequency of elements using recursion
void findFrequency(int arr[], int n, int index = 0) {
    // Base case: if index reaches end of array
    if (index >= n) {
        return;
    }
    
    // Count frequency of current element
    int count = 1;
    
    // Count consecutive duplicates
    while (index + count < n && arr[index] == arr[index + count]) {
        count++;
    }
    
    // Print the element and its frequency
    cout << arr[index] << " appears " << count << " time(s)" << endl;
    
    // Recursive call for next unique element
    findFrequency(arr, n, index + count);
}

// Overloaded function for character arrays
void findFrequency(char arr[], int n, int index = 0) {
    // Base case: if index reaches end of array
    if (index >= n) {
        return;
    }
    
    // Count frequency of current element
    int count = 1;
    
    // Count consecutive duplicates
    while (index + count < n && arr[index] == arr[index + count]) {
        count++;
    }
    
    // Print the element and its frequency
    cout << arr[index] << " appears " << count << " time(s)" << endl;
    
    // Recursive call for next unique element
    findFrequency(arr, n, index + count);
}

int main() {
    // Test with integer array
    int intArr[] = {1, 2, 2, 3, 4, 4, 4, 5, 5};
    int intSize = sizeof(intArr) / sizeof(intArr[0]);
    
    cout << "Frequency of elements in integer array:" << endl;
    cout << "======================================" << endl;
    findFrequency(intArr, intSize);
    
    cout << "\nFrequency of elements in character array:" << endl;
    cout << "==========================================" << endl;
    
    // Test with character array
    char charArr[] = {'a', 'b', 'b', 'c', 'c', 'c', 'd', 'd', 'd', 'e', 'e'};
    int charSize = sizeof(charArr) / sizeof(charArr[0]);
    
    findFrequency(charArr, charSize);
    
    return 0;
}