#include <iostream>
#include <cmath>
using namespace std;

int moveCount = 0; // Global variable to track number of moves

// Recursive function to solve Tower of Hanoi
void towerOfHanoi(int n, char source, char auxiliary, char destination) {
    // Base case: if only 1 disk, move it directly from source to destination
    if (n == 1) {
        moveCount++;
        cout << "Disk 1 moved from " << source << " to " << destination << endl;
        return;
    }
    
    // Move n-1 disks from source to auxiliary using destination as helper
    towerOfHanoi(n - 1, source, destination, auxiliary);
    
    // Move the nth disk from source to destination
    moveCount++;
    cout << "Disk " << n << " moved from " << source << " to " << destination << endl;
    
    // Move n-1 disks from auxiliary to destination using source as helper
    towerOfHanoi(n - 1, auxiliary, source, destination);
}

int main() {
    int numDisks;
    
    cout << "TOWER OF HANOI PUZZLE SOLVER" << endl;
    cout << "============================" << endl;
    cout << "Rules:" << endl;
    cout << "1. Only one disk can be moved at a time." << endl;
    cout << "2. Each move takes the upper disk from one stack." << endl;
    cout << "3. No disk may be placed on top of a smaller disk." << endl;
    cout << endl;
    
    // Input validation
    do {
        cout << "Enter the number of disks (positive integer): ";
        cin >> numDisks;
        
        if (numDisks <= 0) {
            cout << "Invalid input! Please enter a positive number." << endl;
        }
    } while (numDisks <= 0);
    
    cout << "\nSolution for " << numDisks << " disk(s):" << endl;
    cout << "--------------------------------" << endl;
    
    // Reset move counter
    moveCount = 0;
    
    // Solve Tower of Hanoi with 3 rods (A, B, C)
    // A = Source rod, B = Auxiliary rod, C = Destination rod
    towerOfHanoi(numDisks, 'A', 'B', 'C');
    
    // Display total moves
    cout << "\nTotal moves: " << moveCount << endl;
    cout << "Theoretical minimum moves: " << (int)(pow(2, numDisks) - 1) << endl;
    
    return 0;
}